{
  "type": "lightning__agentforceWidget",
  "title": "Contact Quick View",
  "contentBody": {
    "widgetBody": {
      "definition": "tile/widget",
      "children": [
        {
          "definition": "tile/container",
          "children": [
            {
              "definition": "tile/column",
              "attributes": {
                "gap": "lg"
              },
              "children": [
                {
                  "definition": "tile/row",
                  "attributes": {
                    "gap": "md",
                    "align": "center",
                    "justify": "between",
                    "isWrapped": true
                  },
                  "children": [
                    {
                      "definition": "tile/row",
                      "attributes": {
                        "gap": "md",
                        "align": "center"
                      },
                      "children": [
                        {
                          "definition": "tile/avatar",
                          "attributes": {
                            "initials": "{!$attrs.initials}",
                            "alt": "{!$attrs.name}",
                            "size": "lg",
                            "shape": "circle"
                          }
                        },
                        {
                          "definition": "tile/column",
                          "attributes": {
                            "gap": "xs"
                          },
                          "children": [
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "{!$attrs.name}",
                                "variant": "h2",
                                "weight": "semibold"
                              }
                            },
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "{!$attrs.title}",
                                "variant": "body",
                                "color": "muted"
                              }
                            },
                            {
                              "definition": "tile/link",
                              "attributes": {
                                "text": "{!$attrs.accountName}",
                                "href": "{!$attrs.accountUrl}",
                                "variant": "primary"
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "definition": "tile/link",
                      "attributes": {
                        "text": "Open in Salesforce",
                        "href": "{!$attrs.salesforceUrl}",
                        "variant": "primary"
                      }
                    }
                  ]
                },
                {
                  "definition": "tile/separator"
                },
                {
                  "definition": "tile/column",
                  "attributes": {
                    "gap": "sm"
                  },
                  "children": [
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "Contact",
                        "variant": "h4",
                        "weight": "semibold"
                      }
                    },
                    {
                      "definition": "tile/row",
                      "attributes": {
                        "gap": "lg",
                        "justify": "between",
                        "align": "stretch",
                        "isWrapped": true
                      },
                      "children": [
                        {
                          "definition": "tile/column",
                          "attributes": {
                            "gap": "xs"
                          },
                          "children": [
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "Email",
                                "variant": "caption",
                                "color": "muted"
                              }
                            },
                            {
                              "definition": "tile/link",
                              "attributes": {
                                "text": "{!$attrs.email}",
                                "href": "{!$attrs.emailHref}",
                                "variant": "primary"
                              }
                            }
                          ]
                        },
                        {
                          "definition": "tile/column",
                          "attributes": {
                            "gap": "xs"
                          },
                          "children": [
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "Phone",
                                "variant": "caption",
                                "color": "muted"
                              }
                            },
                            {
                              "definition": "tile/link",
                              "attributes": {
                                "text": "{!$attrs.phone}",
                                "href": "{!$attrs.phoneHref}",
                                "variant": "primary"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "definition": "tile/column",
                  "attributes": {
                    "gap": "sm"
                  },
                  "meta": {
                    "if": "{!$attrs.hasDetails}"
                  },
                  "children": [
                    {
                      "definition": "tile/separator"
                    },
                    {
                      "definition": "tile/column",
                      "attributes": {
                        "gap": "xs"
                      },
                      "meta": {
                        "forEach": "{!$attrs.details}",
                        "forItem": "$row",
                        "forIndex": "$i"
                      },
                      "children": [
                        {
                          "definition": "tile/separator",
                          "meta": {
                            "if": "{!AND($row.isGroupStart, $i > 0)}"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$row.groupTitle}",
                            "variant": "h4",
                            "weight": "semibold"
                          },
                          "meta": {
                            "if": "{!$row.isGroupStart}"
                          }
                        },
                        {
                          "definition": "tile/row",
                          "attributes": {
                            "gap": "sm",
                            "align": "center",
                            "justify": "between"
                          },
                          "children": [
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "{!$row.label}",
                                "variant": "caption",
                                "color": "muted"
                              }
                            },
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "{!$row.valueDisplay}",
                                "variant": "body",
                                "weight": "semibold"
                              }
                            }
                          ],
                          "meta": {
                            "if": "{!NOT(OR(LEN(BLANKVALUE($row.valueDisplay, '')) > 48, CONTAINS(BLANKVALUE($row.valueDisplay, ''), '<')))}"
                          }
                        },
                        {
                          "definition": "tile/column",
                          "attributes": {
                            "gap": "xs"
                          },
                          "meta": {
                            "if": "{!OR(LEN(BLANKVALUE($row.valueDisplay, '')) > 48, CONTAINS(BLANKVALUE($row.valueDisplay, ''), '<'))}"
                          },
                          "children": [
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "{!$row.label}",
                                "variant": "caption",
                                "color": "muted"
                              }
                            },
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "{!$row.valueDisplay}",
                                "variant": "body"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "definition": "tile/separator"
                },
                {
                  "definition": "tile/column",
                  "attributes": {
                    "gap": "sm"
                  },
                  "children": [
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "Recent activity",
                        "variant": "h4",
                        "weight": "semibold"
                      }
                    },
                    {
                      "definition": "tile/column",
                      "attributes": {
                        "gap": "xs"
                      },
                      "children": [
                        {
                          "definition": "tile/row",
                          "meta": {
                            "forEach": "{!$attrs.recentActivities}",
                            "forItem": "$activity"
                          },
                          "attributes": {
                            "gap": "md",
                            "align": "center",
                            "justify": "between",
                            "isWrapped": true
                          },
                          "children": [
                            {
                              "definition": "tile/column",
                              "attributes": {
                                "gap": "xs"
                              },
                              "children": [
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "{!$activity.subject}",
                                    "variant": "body"
                                  }
                                },
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "{!$activity.typeLabel}",
                                    "variant": "caption",
                                    "color": "muted"
                                  }
                                }
                              ]
                            },
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "{!$activity.dateDisplay}",
                                "variant": "caption",
                                "color": "muted"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "definition": "tile/row",
                  "attributes": {
                    "gap": "sm",
                    "align": "center",
                    "isWrapped": true
                  },
                  "children": [
                    {
                      "definition": "tile/button",
                      "attributes": {
                        "label": "Email",
                        "variant": "primary",
                        "iconName": "mail"
                      }
                    },
                    {
                      "definition": "tile/button",
                      "attributes": {
                        "label": "Call",
                        "iconName": "phone"
                      }
                    },
                    {
                      "definition": "tile/button",
                      "attributes": {
                        "label": "Open record",
                        "iconName": "open-in-new"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
