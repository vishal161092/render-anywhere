{
  "type": "lightning__agentforceWidget",
  "title": "Asset Detail",
  "contentBody": {
    "widgetBody": {
      "definition": "tile/widget",
      "children": [
        {
          "definition": "tile/container",
          "children": [
            {
              "definition": "tile/column",
              "attributes": {
                "gap": "lg"
              },
              "children": [
                {
                  "definition": "tile/row",
                  "attributes": {
                    "gap": "md",
                    "align": "center",
                    "justify": "between",
                    "isWrapped": true
                  },
                  "children": [
                    {
                      "definition": "tile/column",
                      "attributes": {
                        "gap": "xs"
                      },
                      "children": [
                        {
                          "definition": "tile/row",
                          "attributes": {
                            "gap": "sm",
                            "align": "center",
                            "isWrapped": true
                          },
                          "children": [
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "{!$attrs.assetName}",
                                "variant": "h2",
                                "weight": "semibold"
                              }
                            },
                            {
                              "definition": "tile/badge",
                              "attributes": {
                                "label": "{!$attrs.status}",
                                "variant": "{!$attrs.statusVariant}"
                              }
                            }
                          ]
                        },
                        {
                          "definition": "tile/row",
                          "attributes": {
                            "gap": "sm",
                            "align": "center",
                            "isWrapped": true
                          },
                          "children": [
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "{!$attrs.productName}",
                                "variant": "body",
                                "color": "muted"
                              }
                            },
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "Serial {!$attrs.serialNumber}",
                                "variant": "caption",
                                "color": "muted"
                              },
                              "meta": {
                                "if": "{!LEN(BLANKVALUE($attrs.serialNumber, '')) > 0}"
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "definition": "tile/link",
                      "attributes": {
                        "text": "Open in Salesforce",
                        "href": "{!$attrs.salesforceUrl}",
                        "variant": "primary"
                      }
                    }
                  ]
                },
                {
                  "definition": "tile/column",
                  "attributes": {
                    "gap": "sm"
                  },
                  "meta": {
                    "if": "{!$attrs.hasLifecycle}"
                  },
                  "children": [
                    {
                      "definition": "tile/row",
                      "attributes": {
                        "gap": "sm",
                        "align": "center"
                      },
                      "children": [
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$attrs.lifecycleTitle}",
                            "variant": "h4",
                            "weight": "semibold"
                          }
                        },
                        {
                          "definition": "tile/badge",
                          "attributes": {
                            "label": "{!$attrs.lifecycleStatus}",
                            "variant": "{!$attrs.lifecycleVariant}"
                          }
                        }
                      ]
                    },
                    {
                      "definition": "tile/progress",
                      "attributes": {
                        "label": "{!$attrs.lifecycleStatus}",
                        "value": "{!$attrs.lifecyclePercent}",
                        "max": 100,
                        "color": "{!$attrs.lifecycleColor}",
                        "size": "md"
                      }
                    },
                    {
                      "definition": "tile/row",
                      "attributes": {
                        "gap": "md",
                        "justify": "between",
                        "isWrapped": true
                      },
                      "children": [
                        {
                          "definition": "tile/row",
                          "attributes": {
                            "gap": "xs",
                            "align": "center"
                          },
                          "children": [
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "Installed",
                                "variant": "caption",
                                "color": "muted"
                              }
                            },
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "{!$attrs.lifecycleStartDisplay}",
                                "variant": "caption",
                                "color": "muted"
                              }
                            }
                          ]
                        },
                        {
                          "definition": "tile/row",
                          "attributes": {
                            "gap": "xs",
                            "align": "center"
                          },
                          "children": [
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "Usage ends",
                                "variant": "caption",
                                "color": "muted"
                              }
                            },
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "{!$attrs.lifecycleEndDisplay}",
                                "variant": "caption",
                                "color": "muted"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "definition": "tile/separator"
                },
                {
                  "definition": "tile/row",
                  "attributes": {
                    "gap": "lg",
                    "align": "start",
                    "justify": "between",
                    "isWrapped": true
                  },
                  "children": [
                    {
                      "definition": "tile/column",
                      "attributes": {
                        "gap": "xs"
                      },
                      "children": [
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "Account",
                            "variant": "caption",
                            "color": "muted"
                          }
                        },
                        {
                          "definition": "tile/link",
                          "attributes": {
                            "text": "{!$attrs.accountName}",
                            "href": "{!$attrs.accountUrl}",
                            "variant": "primary"
                          }
                        }
                      ]
                    },
                    {
                      "definition": "tile/column",
                      "attributes": {
                        "gap": "xs"
                      },
                      "children": [
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "Contact",
                            "variant": "caption",
                            "color": "muted"
                          }
                        },
                        {
                          "definition": "tile/row",
                          "attributes": {
                            "gap": "sm",
                            "align": "center"
                          },
                          "children": [
                            {
                              "definition": "tile/avatar",
                              "attributes": {
                                "initials": "{!$attrs.contactInitials}",
                                "alt": "{!$attrs.contactName}",
                                "size": "xs",
                                "shape": "circle"
                              }
                            },
                            {
                              "definition": "tile/link",
                              "attributes": {
                                "text": "{!$attrs.contactName}",
                                "href": "{!$attrs.contactUrl}",
                                "variant": "primary"
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "definition": "tile/column",
                      "attributes": {
                        "gap": "xs"
                      },
                      "children": [
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "Price",
                            "variant": "caption",
                            "color": "muted"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$attrs.priceDisplay}",
                            "variant": "body",
                            "weight": "semibold"
                          }
                        }
                      ]
                    },
                    {
                      "definition": "tile/column",
                      "attributes": {
                        "gap": "xs"
                      },
                      "children": [
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "Quantity",
                            "variant": "caption",
                            "color": "muted"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$attrs.quantityDisplay}",
                            "variant": "body"
                          }
                        }
                      ]
                    },
                    {
                      "definition": "tile/column",
                      "attributes": {
                        "gap": "xs"
                      },
                      "children": [
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "Purchased",
                            "variant": "caption",
                            "color": "muted"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$attrs.purchaseDisplay}",
                            "variant": "body"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "definition": "tile/column",
                  "attributes": {
                    "gap": "sm"
                  },
                  "meta": {
                    "if": "{!$attrs.hasDetails}"
                  },
                  "children": [
                    {
                      "definition": "tile/separator"
                    },
                    {
                      "definition": "tile/column",
                      "attributes": {
                        "gap": "xs"
                      },
                      "meta": {
                        "forEach": "{!$attrs.details}",
                        "forItem": "$row",
                        "forIndex": "$i"
                      },
                      "children": [
                        {
                          "definition": "tile/separator",
                          "meta": {
                            "if": "{!AND($row.isGroupStart, $i > 0)}"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$row.groupTitle}",
                            "variant": "h4",
                            "weight": "semibold"
                          },
                          "meta": {
                            "if": "{!$row.isGroupStart}"
                          }
                        },
                        {
                          "definition": "tile/row",
                          "attributes": {
                            "gap": "sm",
                            "align": "center",
                            "justify": "between"
                          },
                          "children": [
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "{!$row.label}",
                                "variant": "caption",
                                "color": "muted"
                              }
                            },
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "{!$row.valueDisplay}",
                                "variant": "body",
                                "weight": "semibold"
                              }
                            }
                          ],
                          "meta": {
                            "if": "{!NOT(OR(LEN(BLANKVALUE($row.valueDisplay, '')) > 48, CONTAINS(BLANKVALUE($row.valueDisplay, ''), '<')))}"
                          }
                        },
                        {
                          "definition": "tile/column",
                          "attributes": {
                            "gap": "xs"
                          },
                          "meta": {
                            "if": "{!OR(LEN(BLANKVALUE($row.valueDisplay, '')) > 48, CONTAINS(BLANKVALUE($row.valueDisplay, ''), '<'))}"
                          },
                          "children": [
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "{!$row.label}",
                                "variant": "caption",
                                "color": "muted"
                              }
                            },
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "{!$row.valueDisplay}",
                                "variant": "body"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "definition": "tile/column",
                  "attributes": {
                    "gap": "xs"
                  },
                  "meta": {
                    "if": "{!LEN(BLANKVALUE($attrs.description, '')) > 0}"
                  },
                  "children": [
                    {
                      "definition": "tile/separator"
                    },
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "Description",
                        "variant": "h4",
                        "weight": "semibold"
                      }
                    },
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "{!$attrs.description}",
                        "variant": "body"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
